rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images and banners are publicly readable
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Restrict write to authenticated users (should be admin)
    }

    match /banners/{bannerId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile avatars and media
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: no access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

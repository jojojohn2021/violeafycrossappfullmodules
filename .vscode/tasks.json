{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Dev Server",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "tsx server.ts",
                    "endsPattern": "Full-stack Server listening on"
                },
                "pattern": {
                    "regexp": "^.*$"
                }
            }
        }
    ]
}
